{
 "source": "the naming standard enforced by pca naming lint",
 "constructs": [
  {
   "construct": "organization",
   "plane": "tenancy",
   "plane_title": "Tenancy and governance",
   "convention": "<tenant / business-unit>",
   "example": "payments-bu",
   "pattern": "^[a-z][a-z0-9-]{2,30}$"
  },
  {
   "construct": "project",
   "plane": "tenancy",
   "plane_title": "Tenancy and governance",
   "convention": "<team / app-portfolio>",
   "example": "checkout-team",
   "pattern": "^[a-z][a-z0-9-]{2,30}$"
  },
  {
   "construct": "supervisor-namespace",
   "plane": "tenancy",
   "plane_title": "Tenancy and governance",
   "convention": "<app>-<env>-<region>-<sup-hash>",
   "example": "checkout-prod-eu-west-1-g9w34",
   "pattern": "^[a-z][a-z0-9-]+-(dev|staging|prod|demo|sandbox)-[a-z]{2}-[a-z]+-\\d+-[a-z0-9]{5}$"
  },
  {
   "construct": "group-user",
   "plane": "tenancy",
   "plane_title": "Tenancy and governance",
   "convention": "<team>-<role>",
   "example": "checkout-engineers",
   "pattern": "^[a-z][a-z0-9-]+-[a-z]+$"
  },
  {
   "construct": "region",
   "plane": "compute",
   "plane_title": "Provider compute",
   "convention": "<geo>-<direction>-<ordinal>",
   "example": "eu-west-1",
   "pattern": "^[a-z]{2}-[a-z]+-\\d+$"
  },
  {
   "construct": "supervisor",
   "plane": "compute",
   "plane_title": "Provider compute",
   "convention": "<region>-sv-<ordinal>",
   "example": "eu-west-1-sv-01",
   "pattern": "^[a-z]{2}-[a-z]+-\\d+-sv-\\d+$"
  },
  {
   "construct": "supervisor-zone",
   "plane": "compute",
   "plane_title": "Provider compute",
   "convention": "<region>-az<n>",
   "example": "eu-west-1-az1",
   "pattern": "^[a-z]{2}-[a-z]+-\\d+-az\\d+$"
  },
  {
   "construct": "namespace-class",
   "plane": "compute",
   "plane_title": "Provider compute",
   "convention": "ns-<profile>-<size>",
   "example": "ns-general-small",
   "pattern": "^ns-[a-z]+-(tiny|small|medium|large|xlarge)$"
  },
  {
   "construct": "vm-class",
   "plane": "compute",
   "plane_title": "Provider compute",
   "convention": "<qos>-<profile?>-<size>",
   "example": "guaranteed-general-large",
   "pattern": "^(guaranteed|best-effort)-([a-z]+-)?(xsmall|small|medium|large|xlarge)$"
  },
  {
   "construct": "storage-class",
   "plane": "compute",
   "plane_title": "Provider compute",
   "convention": "<media>-<tier>-<ordinal>",
   "example": "ssd-silver-01",
   "pattern": "^[a-z0-9]+-[a-z]+-\\d+$"
  },
  {
   "construct": "content-library",
   "plane": "compute",
   "plane_title": "Provider compute",
   "convention": "cl-<purpose>",
   "example": "cl-golden-images",
   "pattern": "^cl-[a-z0-9-]+$"
  },
  {
   "construct": "vpc",
   "plane": "network",
   "plane_title": "NSX network",
   "convention": "vpc-<consumer>-<region>[-<ordinal>]",
   "example": "vpc-checkout-eu-west-1",
   "pattern": "^vpc-[a-z0-9-]+-[a-z]{2}-[a-z]+-\\d+(-\\d{2,})?$"
  },
  {
   "construct": "vpc-subnet",
   "plane": "network",
   "plane_title": "NSX network",
   "convention": "<access-mode>-<purpose?>-<ordinal>",
   "example": "private-web-01",
   "pattern": "^(private|private-tgw|public)(-[a-z0-9-]+)?-\\d{2,}$"
  },
  {
   "construct": "nsx-project",
   "plane": "network",
   "plane_title": "NSX network",
   "convention": "nsxproj-<org>",
   "example": "nsxproj-payments-bu",
   "pattern": "^nsxproj-[a-z0-9-]+$"
  },
  {
   "construct": "tier-0-gateway",
   "plane": "network",
   "plane_title": "NSX network",
   "convention": "<region>-t0-<role>",
   "example": "eu-west-1-t0-edge",
   "pattern": "^[a-z]{2}-[a-z]+-\\d+-t0-[a-z]+$"
  },
  {
   "construct": "transit-gateway",
   "plane": "network",
   "plane_title": "NSX network",
   "convention": "<region>-tgw",
   "example": "eu-west-1-tgw",
   "pattern": "^[a-z]{2}-[a-z]+-\\d+-tgw$"
  },
  {
   "construct": "ip-block",
   "plane": "network",
   "plane_title": "NSX network",
   "convention": "ipblock-<scope>-<region>",
   "example": "ipblock-public-eu-west-1",
   "pattern": "^ipblock-(private|public|transit)-[a-z]{2}-[a-z]+-\\d+$"
  },
  {
   "construct": "virtualmachine",
   "plane": "workload",
   "plane_title": "Workload",
   "convention": "<app>-<role>-<ordinal>",
   "example": "checkout-web-01",
   "pattern": "^[a-z][a-z0-9-]+-[a-z]+-\\d{2,}$"
  },
  {
   "construct": "vks-cluster",
   "plane": "workload",
   "plane_title": "Workload",
   "convention": "<app>-<env>-vks",
   "example": "checkout-prod-vks",
   "pattern": "^[a-z][a-z0-9-]+-(dev|staging|prod|demo|sandbox)-vks$"
  }
 ]
}
